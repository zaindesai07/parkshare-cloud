# Server Configuration
PORT=5050
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_change_in_production

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parkshare
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# Alternatively, supply a unified connection URL (e.g. for AWS RDS)
# DATABASE_URL=postgresql://user:password@rds-endpoint:5432/parkshare?sslmode=require

# AWS Cloud Services (Optional for offline dev; required for S3 uploads & SNS alerts in production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=parkshare-spaces-bucket
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:parkshare-booking-notifications