# Root .gitignore for ParkShare Cloud

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files and credentials
.env
.env.*
!.env.example

# Production builds
dist/
build/

# Operating System files
.DS_Store
Thumbs.db

# IDE and Editor directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs and coverage
logs/
*.log
coverage/
.nyc_output/
