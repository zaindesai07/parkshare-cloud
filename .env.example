# ParkShare Cloud - Environment Configuration Template
# Copy to backend/.env for local backend development, or configure in hosting provider's dashboard

# Application Server
PORT=5050
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# PostgreSQL Database (Unified Connection URL for Cloud / Render / Neon / Supabase / RDS)
DATABASE_URL=postgres://username:password@hostname:5432/parkshare?sslmode=require
DB_SSL=true

# Alternative Individual Database Variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parkshare
DB_USER=postgres
DB_PASSWORD=
# DB_SSL=false

# AWS Cloud Services (Optional: only needed if using AWS S3 for photos & AWS SNS for alerts)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_SNS_TOPIC_ARN=
AWS_IAM_ROLE=false
